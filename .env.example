# ============================================================
#  GoatBot-Pro — Environment variables (optional)
# ============================================================
#  Copy this file to `.env` and fill in your real values.
#  Any variable set here OVERRIDES the matching value in
#  config.json, so you can keep secrets out of version control.
#
#  ⚠️  The values currently hardcoded inside `config.json`
#  (MongoDB URI, Gmail OAuth, reCAPTCHA) are already public in
#  the git history — ROTATE them and move them here.

# --- Database ---
# Overrides config.json → database.uriMongodb
DATABASE_URI_MONGODB=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true

# --- Facebook account (auto-relogin / cookie renewal) ---
# These enable the bot to log back in AUTOMATICALLY when Facebook
# logs it out, so you never have to paste cookies again.
FACEBOOK_EMAIL=your-bot@email.com
FACEBOOK_PASSWORD=your-password
# The TOTP secret from Facebook 2FA (Settings → Security → Two-factor
# authentication → Setup). Lets the bot pass login-approval automatically.
FACEBOOK_2FA_SECRET=YOUR2FASECRET
# Optional: your Facebook numeric user id (helps some logins)
FACEBOOK_I_USER=100000000000000

# --- Gmail (email notifications / verification codes) ---
GMAIL_EMAIL=your-bot@gmail.com
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token

# --- reCAPTCHA ---
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# --- Bot admins (comma separated Facebook UIDs) ---
ADMIN_BOT=100000000000001,100000000000002
