<%~ includeFile("partials/header.eta", { user: user }); %>
<%~ includeFile("partials/message.eta"); %>

<%
const managedThreads = threads || [];
const commandList = commands || [];
const eventList = events || [];
const safeAdmins = (settings.admins || []).filter(Boolean).join("\n");
const safeWhiteUsers = (settings.whiteListIds || []).join("\n");
const safeWhiteThreads = (settings.whiteListThreadIds || []).join("\n");
const totalMembers = managedThreads.reduce((sum, thread) => sum + ((thread.members || []).filter(member => member.inGroup).length), 0);
const activeWelcome = managedThreads.filter(thread => thread.data?.sendWelcomeMessage !== false).length;
const activeLeave = managedThreads.filter(thread => thread.data?.sendLeaveMessage !== false).length;
const activeRank = managedThreads.filter(thread => thread.data?.rankup !== false).length;
const categories = [...new Set(commandList.map(command => command.category || "عام"))].sort();
const adminCommands = commandList.filter(command => Number(command.role) > 0).length;
const uptimeSeconds = Math.floor((bot && bot.uptime) || 0);
const uptimeDays = Math.floor(uptimeSeconds / 86400);
const uptimeHours = Math.floor((uptimeSeconds % 86400) / 3600);
const uptimeMinutes = Math.floor((uptimeSeconds % 3600) / 60);
%>

<main class="m3-shell" dir="rtl">
  <aside class="m3-rail" aria-label="تنقل لوحة التحكم">
    <div class="m3-rail-brand">
      <span class="m3-logo">R</span>
      <strong>Ragnar</strong>
    </div>
    <a href="#overview" class="active"><i class="fas fa-gauge-high"></i><span>نظرة عامة</span></a>
    <a href="#settings"><i class="fas fa-sliders"></i><span>الإعدادات</span></a>
    <a href="#groups"><i class="fas fa-users"></i><span>المجموعات</span></a>
    <a href="#commands"><i class="fas fa-terminal"></i><span>الأوامر</span></a>
    <a href="#security"><i class="fas fa-shield-halved"></i><span>الحماية</span></a>
  </aside>

  <section class="m3-content">
    <section class="m3-hero" id="overview">
      <div>
        <span class="m3-label">لوحة تحكم Material 3 عربية</span>
        <h1><%= bot.name %></h1>
        <p>مركز تشغيل مفصل للبوت، بدون تسجيل، بدون واجهة قديمة، وبدون عرض أي أسرار جلسة. البرمجة والهوية باسم <strong><%= bot.programmer %></strong>.</p>
        <div class="m3-actions">
          <a class="m3-btn filled" href="#settings">تعديل الإعدادات</a>
          <a class="m3-btn tonal" href="#commands">دليل الأوامر</a>
          <a class="m3-btn outlined" href="/uptime">فحص Uptime</a>
        </div>
      </div>
      <article class="m3-status-card">
        <span class="m3-pulse"></span>
        <h2><%= bot.id !== "غير متصل" ? "جلسة Messenger تعمل" : "في انتظار تسجيل الدخول" %></h2>
        <p>المعرف: <%= bot.id %></p>
        <p>التشغيل: <%= uptimeDays %> يوم · <%= uptimeHours %> ساعة · <%= uptimeMinutes %> دقيقة</p>
      </article>
    </section>

    <section class="m3-stat-grid">
      <article class="m3-stat"><span>المجموعات</span><strong><%= managedThreads.length %></strong></article>
      <article class="m3-stat"><span>الأعضاء النشطين</span><strong><%= totalMembers %></strong></article>
      <article class="m3-stat"><span>الأوامر</span><strong><%= commandList.length %></strong></article>
      <article class="m3-stat"><span>الأحداث</span><strong><%= eventList.length %></strong></article>
      <article class="m3-stat"><span>أوامر الإدارة</span><strong><%= adminCommands %></strong></article>
      <article class="m3-stat"><span>الذاكرة</span><strong><%= bot.memoryMB %>MB</strong></article>
    </section>

    <section class="m3-grid two" id="settings">
      <article class="m3-card wide">
        <div class="m3-card-head">
          <span class="m3-label">إعدادات أساسية</span>
          <h2>تحكم سريع في هوية وسلوك البوت</h2>
        </div>
        <form class="m3-form" id="settings-form">
          <div class="m3-fields">
            <label>اسم البوت<input name="nickNameBot" value="<%= bot.nickName %>" maxlength="80"></label>
            <label>البادئة<input name="prefix" value="<%= bot.prefix %>" maxlength="10"></label>
            <label>اللغة<input name="language" value="<%= bot.language %>" maxlength="10"></label>
          </div>
          <div class="m3-switch-grid">
            <label class="m3-switch"><input type="checkbox" name="antiInbox" <%= settings.antiInbox ? "checked" : "" %>><span></span><b>منع الخاص</b></label>
            <label class="m3-switch"><input type="checkbox" name="noPrefix" <%= settings.noPrefix ? "checked" : "" %>><span></span><b>تشغيل بدون بادئة</b></label>
            <label class="m3-switch"><input type="checkbox" name="adminOnly" <%= settings.adminOnly ? "checked" : "" %>><span></span><b>الأوامر للأدمن فقط</b></label>
            <label class="m3-switch"><input type="checkbox" name="whiteListMode" <%= settings.whiteListMode ? "checked" : "" %>><span></span><b>WhiteList للأشخاص</b></label>
            <label class="m3-switch"><input type="checkbox" name="whiteListThreadMode" <%= settings.whiteListThreadMode ? "checked" : "" %>><span></span><b>WhiteList للجروبات</b></label>
          </div>
          <div class="m3-fields split">
            <label>قائمة الأشخاص المسموحين<textarea name="whiteListIds" rows="5"><%= safeWhiteUsers %></textarea></label>
            <label>قائمة الجروبات المسموحة<textarea name="whiteListThreadIds" rows="5"><%= safeWhiteThreads %></textarea></label>
          </div>
          <button class="m3-btn filled" type="submit">حفظ الإعدادات</button>
          <span class="m3-save-state" id="settings-state"></span>
        </form>
      </article>

      <article class="m3-card" id="security">
        <span class="m3-label">الحماية والجلسة</span>
        <dl class="m3-list">
          <div><dt>مراقب الجلسة</dt><dd>كل <%= settings.sessionRefreshMinutes %> دقيقة</dd></div>
          <div><dt>قاعدة البيانات</dt><dd><%= bot.databaseType %></dd></div>
          <div><dt>Node.js</dt><dd><%= bot.nodeVersion %></dd></div>
          <div><dt>المنصة</dt><dd><%= bot.platform %></dd></div>
          <div><dt>منفذ الداشبورد</dt><dd><%= bot.dashboardPort %></dd></div>
        </dl>
        <div class="m3-note success">لا يتم عرض cookies أو appstate أو كلمات مرور داخل اللوحة.</div>
      </article>
    </section>

    <section class="m3-grid two">
      <article class="m3-card">
        <span class="m3-label">إعدادات المجموعات</span>
        <div class="m3-ring-list">
          <div><strong><%= activeWelcome %></strong><span>ترحيب مفعل</span></div>
          <div><strong><%= activeLeave %></strong><span>وداع مفعل</span></div>
          <div><strong><%= activeRank %></strong><span>Rank مفعل</span></div>
        </div>
      </article>
      <article class="m3-card">
        <span class="m3-label">المبرمج والهوية</span>
        <h2><%= bot.programmer %></h2>
        <p class="m3-muted">كل الواجهة الجديدة والبراند الظاهر للمستخدم باسم RagnarBot-V0 فقط.</p>
        <div class="m3-chip-row"><span>Material 3</span><span>RTL</span><span>No Login</span><span>No Credits UI</span></div>
      </article>
    </section>

    <section class="m3-card" id="groups">
      <div class="m3-card-head row">
        <div><span class="m3-label">المجموعات</span><h2>فهرس الجروبات والإعدادات</h2></div>
        <div class="m3-search"><i class="fas fa-search"></i><input id="thread-search" placeholder="ابحث بالاسم أو ID"></div>
      </div>
      <div class="m3-table-wrap" id="threads-panel" data-list="">
        <table class="m3-table">
          <thead><tr><th>#</th><th>اسم المجموعة</th><th>ID</th><th>الأعضاء</th><th>الترحيب</th><th>الوداع</th><th>الرتب</th><th>البادئة</th></tr></thead>
          <tbody class="list">
            <% managedThreads.forEach((thread, index) => { %>
            <% const memberCount = (thread.members || []).filter(member => member.inGroup).length; %>
            <tr>
              <td><%= index + 1 %></td>
              <td class="thread_name"><%= thread.threadName || "مجموعة بدون اسم" %></td>
              <td class="thread_id"><code><%= thread.threadID %></code></td>
              <td class="members"><%= memberCount %></td>
              <td><span class="m3-badge <%= thread.data?.sendWelcomeMessage === false ? "off" : "" %>"><%= thread.data?.sendWelcomeMessage === false ? "متوقف" : "مفعل" %></span></td>
              <td><span class="m3-badge <%= thread.data?.sendLeaveMessage === false ? "off" : "" %>"><%= thread.data?.sendLeaveMessage === false ? "متوقف" : "مفعل" %></span></td>
              <td><span class="m3-badge <%= thread.data?.rankup === false ? "off" : "" %>"><%= thread.data?.rankup === false ? "متوقف" : "مفعل" %></span></td>
              <td><code><%= thread.data?.prefix || bot.prefix %></code></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <ul class="pagination m3-pagination"></ul>
      </div>
    </section>

    <section class="m3-card" id="commands">
      <div class="m3-card-head row">
        <div><span class="m3-label">دليل الأوامر</span><h2>كل الأوامر المحملة</h2></div>
        <div class="m3-search"><i class="fas fa-search"></i><input id="command-search" placeholder="ابحث عن أمر أو تصنيف"></div>
      </div>
      <div class="m3-chip-row categories"><% categories.forEach(category => { %><span><%= category %></span><% }) %></div>
      <div class="m3-command-grid list" id="commands-panel" data-list="">
        <% commandList.forEach(command => { %>
        <article class="m3-command-card">
          <span class="category"><%= command.category %></span>
          <h3 class="name"><%= command.name %></h3>
          <p class="description"><%= command.description %></p>
          <div><span class="role">صلاحية <%= command.role %></span><span class="cooldown">مهلة <%= command.countDown %>ث</span></div>
          <% if (command.aliases.length) { %><small class="aliases"><%= command.aliases.join(", ") %></small><% } %>
        </article>
        <% }) %>
      </div>
      <ul class="pagination m3-pagination"></ul>
    </section>

    <section class="m3-grid two">
      <article class="m3-card">
        <span class="m3-label">الأحداث</span>
        <div class="m3-event-list">
          <% eventList.slice(0, 12).forEach(event => { %>
          <div><strong><%= event.name %></strong><span><%= event.description %></span></div>
          <% }) %>
          <% if (!eventList.length) { %><div><strong>لا توجد أحداث</strong><span>لم يتم تحميل Event Commands</span></div><% } %>
        </div>
      </article>
      <article class="m3-card">
        <span class="m3-label">سجلات وتشغيل</span>
        <pre class="m3-log">RagnarBot-V0 initialized
Programmer: Saga Sama
Dashboard: Material 3 RTL
Database: <%= bot.databaseType %>
Commands: <%= commandList.length %>
Threads: <%= managedThreads.length %>
Session: <%= bot.id !== "غير متصل" ? "online" : "pending" %></pre>
      </article>
    </section>
  </section>
</main>

<script>
  const threadsList = new List("threads-panel", { valueNames: ["thread_name", "thread_id", "members"], page: 12, pagination: true });
  const commandsList = new List("commands-panel", { valueNames: ["name", "description", "category", "role", "cooldown", "aliases"], page: 12, pagination: true });

  $("#thread-search").on("keyup change paste", function() { threadsList.search($(this).val()); });
  $("#command-search").on("keyup change paste", function() { commandsList.search($(this).val()); });

  $("#settings-form").on("submit", async function(event) {
    event.preventDefault();
    const state = $("#settings-state");
    state.text("جارٍ الحفظ...");
    try {
      const res = await fetch("/dashboard/settings", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" }, body: new URLSearchParams(new FormData(this)) });
      const data = await res.json();
      state.text(data.message || "تم الحفظ");
    } catch (err) {
      state.text("فشل الحفظ: " + err.message);
    }
  });
</script>

<%~ includeFile("partials/footer.eta") %>
