<%~ includeFile("partials/header.eta", {
	user: user
}); %>
<%~ includeFile("partials/message.eta"); %>

<% const managedThreads = threads || []; %>
<% const totalMembers = managedThreads.reduce((sum, thread) => sum + ((thread.members || []).filter(member => member.inGroup).length), 0); %>

<main class="heritage-page">
  <section class="heritage-hero heritage-dashboard-hero">
    <div class="container">
      <div class="heritage-kicker">Control room</div>
      <div class="heritage-hero-grid">
        <div>
          <h1>Manage every conversation with editorial clarity.</h1>
          <p>Review groups, search by name or thread ID, and open precise controls for welcome messages, rank settings, custom commands, and moderation.</p>
        </div>
        <div class="heritage-status-card">
          <span class="heritage-status-dot"></span>
          <strong>System ready</strong>
          <small><%= managedThreads.length %> managed threads · <%= totalMembers %> active members</small>
        </div>
      </div>
    </div>
  </section>

  <section class="container heritage-section">
    <div class="heritage-metrics">
      <article class="heritage-metric-card">
        <span>Threads</span>
        <strong><%= managedThreads.length %></strong>
      </article>
      <article class="heritage-metric-card">
        <span>Members</span>
        <strong><%= totalMembers %></strong>
      </article>
      <article class="heritage-metric-card">
        <span>Prefix</span>
        <strong><%= global.GoatBot.config.prefix %></strong>
      </article>
    </div>

    <div class="heritage-panel" id="table-threads" data-list="">
      <div class="heritage-panel-head">
        <div>
          <span class="heritage-kicker">Thread index</span>
          <h2>Groups you manage</h2>
        </div>
        <div class="heritage-tools">
          <div class="heritage-search">
            <i class="fas fa-search"></i>
            <input class="search" type="search" placeholder="Search threads" aria-label="Search" id="search-input">
          </div>
          <select id="searchBy" aria-label="Search by">
            <option value="thread_id" selected>Box ID</option>
            <option value="thread_name">Box name</option>
          </select>
          <button class="heritage-button heritage-button-secondary" id="reset-button" type="button">
            Reset
          </button>
        </div>
      </div>

      <div class="heritage-table-wrap">
        <table class="heritage-table">
          <thead>
            <tr>
              <th>No.</th>
              <th class="sort" data-sort="thread_id">Box ID</th>
              <th class="sort" data-sort="thread_name">Box name</th>
              <th class="sort" data-sort="members">Members</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody class="list">
            <% for (let i = 0; i < managedThreads.length; i++) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td class="thread_id"><code><%= managedThreads[i].threadID %></code></td>
              <td class="thread_name"><%= managedThreads[i].threadName || "Untitled thread" %></td>
              <td class="members"><%= (managedThreads[i].members || []).filter(member => member.inGroup).length %></td>
              <td>
                <a href="/dashboard/<%= managedThreads[i].threadID %>" class="heritage-action">Configure</a>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <ul class="pagination heritage-pagination"></ul>
    </div>
  </section>
</main>

<script>
  const options = {
    valueNames: ["thread_id", "thread_name", "members"],
    page: 10,
    pagination: true
  };

  const listThread = new List("table-threads", options);
  const resetButton = $("#reset-button");
  const searchInput = $("#search-input");
  const searchBy = $("#searchBy");

  $("#search-input, #searchBy").on("keyup change paste", function() {
    const searchValue = searchInput.val();
    const searchByValue = searchBy.val();
    if (searchByValue)
      listThread.search(searchValue, [searchByValue]);
    else
      listThread.search();
  });

  resetButton.on("click", function() {
    searchInput.val("");
    listThread.search();
  });
</script>

<%~ includeFile("partials/footer.eta") %>
