<%~ includeFile("partials/header.eta", { user: user }); %>
<%~ includeFile("partials/message.eta"); %>
<%
  const shortcuts = [
    { name: "{userName}", desc: "اسم العضو المغادر" },
    { name: "{userNameTag}", desc: "اسم العضو مع الإشارة" },
    { name: "{threadName}", desc: "اسم المجموعة" },
    { name: "{boxName}", desc: "اسم المجموعة" },
    { name: "{session}", desc: "الفترة الحالية من اليوم" },
    { name: "{multiple}", desc: "صيغة المفرد أو الجمع" },
    { name: "{type}", desc: "غادر بنفسه أو أزيل بواسطة مشرف" }
  ];
%>

<section class="ragnar-page-head">
  <div>
    <a href="/dashboard/<%= threadID %>" class="ragnar-kicker text-decoration-none"><i class="fa-solid fa-arrow-right ms-1"></i> الرجوع لإعدادات المجموعة</a>
    <h1 class="ragnar-page-title">رسالة المغادرة</h1>
    <p class="ragnar-page-description mb-0">تخصيص الرسالة والملفات التي يرسلها البوت عند مغادرة عضو من <strong><%= threadData.threadName || "المجموعة" %></strong>.</p>
  </div>
  <span class="ragnar-badge primary"><i class="fa-solid fa-person-walking-arrow-right"></i> حدث المغادرة</span>
</section>

<section class="row g-3 mb-4">
  <div class="col-lg-4">
    <article class="ragnar-card p-3 p-md-4 h-100">
      <h2 class="ragnar-section-title mb-2">المتغيرات المتاحة</h2>
      <p class="ragnar-section-subtitle mb-3">انقر على أي متغير لنسخه ثم أضفه داخل الرسالة.</p>
      <div class="d-flex flex-column gap-2">
        <% for (const item of shortcuts) { %>
        <button class="btn btn-ragnar-ghost text-end copy-shortcut" type="button" data-value="<%= item.name %>"><code dir="ltr"><%= item.name %></code><span class="ragnar-muted me-2"><%= item.desc %></span></button>
        <% } %>
      </div>
    </article>
  </div>
  <div class="col-lg-8">
    <article class="ragnar-card p-3 p-md-4 h-100">
      <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <div><h2 class="ragnar-section-title mb-1">نص رسالة المغادرة</h2><p class="ragnar-section-subtitle mb-0">استخدم المتغيرات لتكييف الرسالة تلقائيًا.</p></div>
        <span class="ragnar-badge muted"><i class="fa-solid fa-database"></i> محفوظ في المجموعة</span>
      </div>
      <label for="message" class="visually-hidden">رسالة المغادرة</label>
      <textarea class="form-control" rows="9" id="message" spellcheck="false"><%= threadData.data.leaveMessage || defaultLeaveMessage %></textarea>
      <div class="d-flex flex-wrap gap-2 mt-3">
        <button class="btn btn-ragnar-primary" id="save-message" type="button"><i class="fa-solid fa-floppy-disk ms-1"></i> حفظ الرسالة</button>
        <button class="btn btn-ragnar-secondary" id="reset-message" type="button"><i class="fa-solid fa-arrow-rotate-left ms-1"></i> استعادة الافتراضية</button>
      </div>
    </article>
  </div>
</section>

<section class="ragnar-card p-3 p-md-4">
  <div class="ragnar-page-head mb-3">
    <div>
      <h2 class="ragnar-section-title">مرفقات المغادرة</h2>
      <p class="ragnar-section-subtitle">يمكن حفظ حتى 20 ملفًا. الحد الأقصى للملف العادي 25 ميغابايت، وللفيديو 83 ميغابايت.</p>
    </div>
    <label for="attachment-input" class="btn btn-ragnar-secondary"><i class="fa-solid fa-cloud-arrow-up ms-1"></i> اختيار ملفات</label>
    <input id="attachment-input" type="file" class="d-none" multiple>
  </div>

  <div id="upload-status" class="ragnar-muted mb-3">لم تختر أي ملفات للرفع.</div>
  <div class="d-flex gap-2 mb-4 d-none" id="upload-actions"><button type="button" class="btn btn-ragnar-primary" id="upload-files"><i class="fa-solid fa-upload ms-1"></i> رفع الملفات المحددة</button><button type="button" class="btn btn-ragnar-ghost" id="cancel-files">إلغاء</button></div>

  <% if (leaveAttachments.length) { %>
  <div class="ragnar-table-card border rounded-4" id="attachment-table">
    <table class="table align-middle">
      <thead><tr><th>الملف</th><th>الحجم</th><th>تاريخ الإضافة</th><th class="text-start">إجراء</th></tr></thead>
      <tbody>
        <% for (const file of leaveAttachments) { %>
        <tr data-file-id="<%= file.id %>">
          <td><a href="<%= file.urlDownload %>" target="_blank" rel="noopener" class="text-decoration-none"><i class="fa-solid fa-paperclip ms-1"></i> <%= file.name %></a></td>
          <td><%= convertSize(file.size) %></td>
          <td><%= new Date(file.createdTime).toLocaleString("ar-EG") %></td>
          <td class="text-start"><button type="button" class="btn btn-ragnar-ghost delete-file" data-file-id="<%= file.id %>"><i class="fa-solid fa-trash"></i><span class="visually-hidden">حذف الملف</span></button></td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="ragnar-empty border rounded-4"><i class="fa-solid fa-paperclip"></i><strong class="d-block mb-2">لا توجد مرفقات مغادرة</strong><span>اختر ملفات لإرفاقها مع رسالة المغادرة.</span></div>
  <% } %>
</section>

<script>
  (function () {
    const threadID = '<%= threadID %>';
    const defaultMessage = <%- JSON.stringify(defaultLeaveMessage) %>;
    const input = document.getElementById('attachment-input');
    function toast(type, title, message) { $.createToast({ type: type, title: title, message: message }); }
    function saveMessage(message, type, onSuccess) {
      $.post('/api/thread/setData/leaveMessage', { threadID: threadID, message: message, type: type })
        .done(function () { toast('success', 'تم الحفظ', type === 'update' ? 'تم حفظ رسالة المغادرة.' : 'تمت استعادة الرسالة الافتراضية.'); if (onSuccess) onSuccess(); })
        .fail(function (xhr) { toast('error', 'تعذر الحفظ', xhr.responseJSON?.message || 'حاول مجددًا بعد التحقق من الصلاحيات.'); });
    }
    $('.copy-shortcut').on('click', function () { const value = this.dataset.value; navigator.clipboard?.writeText(value); const textarea = document.getElementById('message'); textarea.focus(); textarea.setRangeText(value, textarea.selectionStart, textarea.selectionEnd, 'end'); toast('success', 'تمت الإضافة', `أضيف ${value} إلى الرسالة.`); });
    $('#save-message').on('click', function () { saveMessage($('#message').val(), 'update'); });
    $('#reset-message').on('click', function () { $('#message').val(defaultMessage); saveMessage('', 'delete'); });
    input.addEventListener('change', function () { const files = Array.from(input.files); $('#upload-status').text(files.length ? `تم اختيار ${files.length} ملفًا للرفع.` : 'لم تختر أي ملفات للرفع.'); $('#upload-actions').toggleClass('d-none', !files.length); });
    $('#cancel-files').on('click', function () { input.value = ''; input.dispatchEvent(new Event('change')); });
    $('#upload-files').on('click', function () {
      const files = Array.from(input.files); if (!files.length) return;
      const data = new FormData(); files.forEach(file => data.append('attachments', file)); data.append('threadID', threadID); data.append('commandName', 'setleave');
      $('#upload-files').prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin ms-1"></i> جارٍ الرفع');
      $.ajax({ url: '/api/upload/leaveAttachment', method: 'POST', data: data, processData: false, contentType: false })
        .done(function () { toast('success', 'اكتمل الرفع', 'تمت إضافة المرفقات بنجاح.'); window.setTimeout(() => location.reload(), 500); })
        .fail(function (xhr) { toast('error', 'تعذر الرفع', xhr.responseJSON?.message || 'تعذر رفع الملفات.'); $('#upload-files').prop('disabled', false).html('<i class="fa-solid fa-upload ms-1"></i> رفع الملفات المحددة'); });
    });
    $('.delete-file').on('click', function () { const id = this.dataset.fileId; if (!window.confirm('هل تريد حذف هذا المرفق؟')) return; $.post('/api/delete/leaveAttachment', { fileIDs: [id], threadID: threadID, location: 'data.leaveAttachment' }).done(function () { $(`tr[data-file-id="${id}"]`).remove(); toast('success', 'تم الحذف', 'تم حذف المرفق من رسالة المغادرة.'); }).fail(function (xhr) { toast('error', 'تعذر الحذف', xhr.responseJSON?.message || 'حاول مجددًا.'); }); });
  })();
</script>

<%~ includeFile("partials/footer.eta") %>
