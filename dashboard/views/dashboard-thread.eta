<%~ includeFile("partials/header.eta", { user: user }); %>
<%~ includeFile("partials/message.eta"); %>
<%
  const { threadID } = threadData;
  const members = (threadData.members || []).filter(member => member.inGroup);
  const groupAdmins = threadData.adminIDs || [];
  const isEditable = authConfigDashboard === true;
%>

<section class="ragnar-page-head">
  <div>
    <a href="/dashboard" class="ragnar-kicker text-decoration-none"><i class="fa-solid fa-arrow-right ms-1"></i> الرجوع إلى المجموعات</a>
    <h1 class="ragnar-page-title"><%= threadData.threadName || "مجموعة بلا اسم" %></h1>
    <p class="ragnar-page-description mb-0">إعدادات المجموعة وتفاصيلها محفوظة مباشرة في قاعدة بيانات البوت.</p>
  </div>
  <span class="ragnar-badge <%= isEditable ? "success" : "warning" %>"><i class="fa-solid <%= isEditable ? "fa-pen-to-square" : "fa-eye" %>"></i> <%= isEditable ? "لديك صلاحية التعديل" : "وضع العرض فقط" %></span>
</section>

<section class="ragnar-card p-3 p-md-4 mb-4">
  <div class="row align-items-center g-3">
    <div class="col-md-auto">
      <span class="ragnar-avatar" style="width: 4.25rem; height: 4.25rem; font-size: 1.45rem;"><i class="fa-solid fa-comments"></i></span>
    </div>
    <div class="col-md">
      <h2 class="ragnar-section-title mb-2">بيانات المجموعة الحالية</h2>
      <div class="ragnar-info-grid">
        <div class="ragnar-info-item"><div class="ragnar-info-label">معرّف المجموعة</div><div class="ragnar-info-value" dir="ltr"><%= threadID %></div></div>
        <div class="ragnar-info-item"><div class="ragnar-info-label">الأعضاء الموجودون</div><div class="ragnar-info-value"><%= members.length.toLocaleString("ar-EG") %> عضو</div></div>
        <div class="ragnar-info-item"><div class="ragnar-info-label">مشرفو المجموعة</div><div class="ragnar-info-value"><%= groupAdmins.length.toLocaleString("ar-EG") %> مشرف</div></div>
        <div class="ragnar-info-item"><div class="ragnar-info-label">تفعيلات قيد التشغيل</div><div class="ragnar-info-value"><%= settingsSummary %> إعداد</div></div>
      </div>
    </div>
  </div>
</section>

<% if (!isEditable) { %>
<div class="alert alert-warning border-0 rounded-4 mb-4" role="alert"><i class="fa-solid fa-triangle-exclamation ms-1"></i> يمكنك مشاهدة الإعدادات، لكن الحفظ متاح لمشرفي المجموعة أو للأعضاء الممنوحين صلاحية الإدارة فقط.</div>
<% } %>

<form id="settings-form">
  <section class="mb-4">
    <div class="ragnar-page-head mb-3">
      <div>
        <h2 class="ragnar-section-title">التشغيل التلقائي</h2>
        <p class="ragnar-section-subtitle">تؤثر هذه المفاتيح في الأحداث والأوامر التي يقرأها البوت فعلًا.</p>
      </div>
      <button type="submit" class="btn btn-ragnar-primary" <%= isEditable ? "" : "disabled" %>><i class="fa-solid fa-floppy-disk ms-1"></i> حفظ التغييرات</button>
    </div>

    <div class="row g-3">
      <div class="col-md-6 col-xl-4">
        <article class="ragnar-card ragnar-setting-card">
          <span class="setting-icon"><i class="fa-solid fa-hand-sparkles"></i></span>
          <div class="d-flex justify-content-between gap-3"><h3>رسالة الترحيب</h3><div class="form-check form-switch m-0"><input class="form-check-input setting-toggle" type="checkbox" id="sw-welcome" <%= threadData.settings.sendWelcomeMessage ? "checked" : "" %> <%= isEditable ? "" : "disabled" %>></div></div>
          <p>يرسل البوت رسالة عند انضمام عضو جديد.</p>
          <a href="/dashboard/<%= threadID %>/welcome" class="btn btn-ragnar-ghost w-100"><i class="fa-solid fa-pen ms-1"></i> تخصيص النص والمرفقات</a>
        </article>
      </div>
      <div class="col-md-6 col-xl-4">
        <article class="ragnar-card ragnar-setting-card">
          <span class="setting-icon"><i class="fa-solid fa-person-walking-arrow-right"></i></span>
          <div class="d-flex justify-content-between gap-3"><h3>رسالة المغادرة</h3><div class="form-check form-switch m-0"><input class="form-check-input setting-toggle" type="checkbox" id="sw-leave" <%= threadData.settings.sendLeaveMessage ? "checked" : "" %> <%= isEditable ? "" : "disabled" %>></div></div>
          <p>يرسل البوت رسالة عند مغادرة عضو للمجموعة.</p>
          <a href="/dashboard/<%= threadID %>/leave" class="btn btn-ragnar-ghost w-100"><i class="fa-solid fa-pen ms-1"></i> تخصيص النص والمرفقات</a>
        </article>
      </div>
      <div class="col-md-6 col-xl-4">
        <article class="ragnar-card ragnar-setting-card">
          <span class="setting-icon"><i class="fa-solid fa-trophy"></i></span>
          <div class="d-flex justify-content-between gap-3"><h3>إشعار الترقية</h3><div class="form-check form-switch m-0"><input class="form-check-input setting-toggle" type="checkbox" id="sw-rankup" <%= threadData.settings.sendRankupMessage ? "checked" : "" %> <%= isEditable ? "" : "disabled" %>></div></div>
          <p>يبلغ العضو عندما يرتفع مستواه في نظام النقاط.</p>
          <a href="/dashboard/<%= threadID %>/rankup" class="btn btn-ragnar-ghost w-100"><i class="fa-solid fa-gear ms-1"></i> إعداد الرسالة</a>
        </article>
      </div>
      <div class="col-md-6 col-xl-4">
        <article class="ragnar-card ragnar-setting-card">
          <span class="setting-icon"><i class="fa-solid fa-terminal"></i></span>
          <div class="d-flex justify-content-between gap-3"><h3>الأوامر المخصصة</h3><div class="form-check form-switch m-0"><input class="form-check-input setting-toggle" type="checkbox" id="sw-customcmd" <%= threadData.settings.customCommand ? "checked" : "" %> <%= isEditable ? "" : "disabled" %>></div></div>
          <p>يسمح بتنفيذ الأوامر المخصصة المسجلة للمجموعة.</p>
          <a href="/dashboard/<%= threadID %>/custom-cmd" class="btn btn-ragnar-ghost w-100"><i class="fa-solid fa-list-check ms-1"></i> مراجعة الأوامر</a>
        </article>
      </div>
      <div class="col-md-6 col-xl-4">
        <article class="ragnar-card ragnar-setting-card">
          <span class="setting-icon"><i class="fa-solid fa-filter-circle-xmark"></i></span>
          <div class="d-flex justify-content-between gap-3"><h3>فلتر الكلمات</h3><div class="form-check form-switch m-0"><input class="form-check-input setting-toggle" type="checkbox" id="sw-badwords" <%= threadData.settings.badWords ? "checked" : "" %> <%= isEditable ? "" : "disabled" %>></div></div>
          <p>يشغّل فلتر الكلمات الذي يستخدمه أمر إدارة الكلمات.</p>
          <span class="ragnar-badge muted">يُدار من أمر الكلمات في المحادثة</span>
        </article>
      </div>
      <div class="col-md-6 col-xl-4">
        <article class="ragnar-card ragnar-setting-card">
          <span class="setting-icon"><i class="fa-solid fa-bell-slash"></i></span>
          <div class="d-flex justify-content-between gap-3"><h3>إخفاء تنبيهات النظام</h3><div class="form-check form-switch m-0"><input class="form-check-input setting-toggle" type="checkbox" id="sw-hide-noti" <%= threadData.settings.hideNotiMessage ? "checked" : "" %> <%= isEditable ? "" : "disabled" %>></div></div>
          <p>يخفي رسائل التنبيه الآلية التي لا تحتاج إليها المجموعة.</p>
          <span class="ragnar-badge muted">يطبق عند توفر الإشعار</span>
        </article>
      </div>
    </div>
  </section>

  <section class="row g-3 mb-4">
    <div class="col-lg-5">
      <article class="ragnar-card p-3 p-md-4 h-100">
        <h2 class="ragnar-section-title mb-1">لغة رسائل هذه المجموعة</h2>
        <p class="ragnar-section-subtitle mb-3">يحفظ الاختيار في بيانات المجموعة ويُستخدم عند وجود ترجمة مطابقة.</p>
        <label for="thread-language" class="form-label ragnar-muted">رمز اللغة</label>
        <select id="thread-language" class="form-select" <%= isEditable ? "" : "disabled" %>>
          <option value="ar" <%= threadData.data.lang === "ar" ? "selected" : "" %>>العربية</option>
          <option value="en" <%= threadData.data.lang === "en" ? "selected" : "" %>>الإنجليزية</option>
          <option value="vi" <%= threadData.data.lang === "vi" ? "selected" : "" %>>الفيتنامية</option>
          <option value="bn" <%= threadData.data.lang === "bn" ? "selected" : "" %>>البنغالية</option>
          <option value="hi" <%= threadData.data.lang === "hi" ? "selected" : "" %>>الهندية</option>
          <option value="tl" <%= threadData.data.lang === "tl" ? "selected" : "" %>>التاغالوغية</option>
        </select>
        <button type="button" class="btn btn-ragnar-secondary mt-3" id="save-language" <%= isEditable ? "" : "disabled" %>><i class="fa-solid fa-language ms-1"></i> حفظ اللغة</button>
      </article>
    </div>
    <div class="col-lg-7">
      <article class="ragnar-card p-3 p-md-4 h-100">
        <h2 class="ragnar-section-title mb-1">إعدادات متقدمة من المحادثة</h2>
        <p class="ragnar-section-subtitle mb-3">هذه الإعدادات متاحة بالفعل في البوت، وتحتاج قيمة مخصصة أو قائمة عناصر؛ لذلك بقيت في أوامر المحادثة بدل حقول وهمية.</p>
        <div class="d-flex flex-wrap gap-2">
          <span class="ragnar-badge muted"><i class="fa-solid fa-list-ol"></i> القواعد</span>
          <span class="ragnar-badge muted"><i class="fa-solid fa-triangle-exclamation"></i> التحذيرات</span>
          <span class="ragnar-badge muted"><i class="fa-solid fa-user-tag"></i> أدوار الأعضاء</span>
          <span class="ragnar-badge muted"><i class="fa-solid fa-shield-halved"></i> حماية المجموعة</span>
          <span class="ragnar-badge muted"><i class="fa-solid fa-tags"></i> وسوم المجموعة</span>
        </div>
      </article>
    </div>
  </section>
</form>

<section class="ragnar-card p-3 p-md-4 mb-4">
  <div class="ragnar-page-head mb-3">
    <div>
      <h2 class="ragnar-section-title">صلاحيات إدارة اللوحة</h2>
      <p class="ragnar-section-subtitle">مشرفو المجموعة لديهم الصلاحية تلقائيًا. يمكن للمشرف فقط منح عضو آخر حق التعديل.</p>
    </div>
    <% if (isThreadAdmin) { %><button class="btn btn-ragnar-secondary" id="save-permissions" type="button"><i class="fa-solid fa-user-shield ms-1"></i> حفظ الصلاحيات</button><% } %>
  </div>

  <div class="row g-2" id="permissions-list">
    <% for (const member of members) { const isGroupAdmin = groupAdmins.includes(member.userID); %>
    <div class="col-md-6 col-xl-4">
      <div class="ragnar-member-row">
        <div class="min-w-0">
          <div class="ragnar-member-name text-truncate"><%= member.name || "عضو بلا اسم" %></div>
          <div class="ragnar-member-id"><%= member.userID %></div>
        </div>
        <% if (isGroupAdmin) { %>
          <span class="ragnar-badge primary"><i class="fa-solid fa-crown"></i> مشرف المجموعة</span>
        <% } else { %>
          <div class="form-check form-switch m-0"><input class="form-check-input member-permission" type="checkbox" value="<%= member.userID %>" <%= member.permissionConfigDashboard ? "checked" : "" %> <%= isThreadAdmin ? "" : "disabled" %> aria-label="منح صلاحية الإدارة لـ <%= member.name || member.userID %>"></div>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
</section>

<script>
  (function () {
    const threadID = '<%= threadID %>';
    const editable = <%= isEditable ? 'true' : 'false' %>;
    const groupAdmin = <%= isThreadAdmin ? 'true' : 'false' %>;

    function showToast(type, title, message) {
      $.createToast({ type: type, title: title, message: message });
    }

    function request(url, data, successMessage) {
      return $.ajax({ url: url, type: 'POST', data: data })
        .done(function () { showToast('success', 'تم الحفظ', successMessage); })
        .fail(function (xhr) { showToast('error', 'تعذر الحفظ', xhr.responseJSON?.message || 'تحقق من الصلاحيات ثم حاول مجددًا.'); });
    }

    $('#settings-form').on('submit', function (event) {
      event.preventDefault();
      if (!editable) return showToast('warning', 'صلاحية مطلوبة', 'هذه المجموعة متاحة للعرض فقط لحسابك.');
      request('/api/thread/setData/settings', {
        threadID: threadID,
        updateData: {
          sendWelcomeMessage: $('#sw-welcome').is(':checked'),
          sendLeaveMessage: $('#sw-leave').is(':checked'),
          sendRankupMessage: $('#sw-rankup').is(':checked'),
          customCommand: $('#sw-customcmd').is(':checked'),
          badWords: $('#sw-badwords').is(':checked'),
          hideNotiMessage: $('#sw-hide-noti').is(':checked')
        }
      }, 'تم تحديث إعدادات التشغيل التلقائي.');
    });

    $('#save-language').on('click', function () {
      if (!editable) return;
      request('/api/thread/setData/groupData', { threadID: threadID, updateData: { lang: $('#thread-language').val() } }, 'تم حفظ لغة رسائل المجموعة.');
    });

    $('#save-permissions').on('click', function () {
      if (!groupAdmin) return;
      const permissions = {};
      $('.member-permission').each(function () { permissions[this.value] = $(this).is(':checked'); });
      request('/api/thread/setData/memberPermissions', { threadID: threadID, permissions: JSON.stringify(permissions) }, 'تم تحديث صلاحيات الإدارة.');
    });
  })();
</script>

<%~ includeFile("partials/footer.eta") %>
