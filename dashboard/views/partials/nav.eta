<nav class="navbar navbar-expand-lg fixed-top navbar-top ragnar-nav" aria-label="التنقل الرئيسي">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" href="/dashboard" aria-label="العودة إلى لوحة التحكم">
      <span class="ragnar-brand-mark"><i class="fa-solid fa-shield-halved"></i></span>
      <span class="fw-bold">Ragnar <small class="d-none d-sm-inline text-body-secondary">مركز التحكم</small></span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navcollapse" aria-controls="navcollapse" aria-expanded="false" aria-label="فتح القائمة">
      <span class="navbar-toggle-icon"><span class="toggle-line"></span></span>
    </button>

    <div class="collapse navbar-collapse" id="navcollapse">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a href="/dashboard" class="nav-link px-2"><i class="fa-solid fa-gauge-high ms-1"></i> لوحة التحكم</a>
        </li>
        <li class="nav-item">
          <a href="/stats" class="nav-link px-2"><i class="fa-solid fa-chart-column ms-1"></i> حالة البوت</a>
        </li>
        <li class="nav-item">
          <a href="/profile" class="nav-link px-2"><i class="fa-solid fa-user-gear ms-1"></i> الحساب</a>
        </li>
      </ul>

      <ul class="navbar-nav align-items-lg-center">
        <% if (user) { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle px-2" data-bs-toggle="dropdown" href="#" role="button" id="userDropdown" aria-expanded="false">
            <i class="fa-solid fa-circle-user ms-1"></i> <%= user.name %>
          </a>
          <ul class="dropdown-menu mb-2" aria-labelledby="userDropdown">
            <% if (!user.facebookUserID) { %>
            <li><a href="/verifyfbid" class="dropdown-item"><i class="fa-solid fa-user-check ms-1"></i> ربط معرّف فيسبوك</a></li>
            <% } %>
            <li><a href="/profile" class="dropdown-item"><i class="fa-solid fa-address-card ms-1"></i> الملف الشخصي</a></li>
            <li><a href="/change-password" class="dropdown-item"><i class="fa-solid fa-key ms-1"></i> تغيير كلمة المرور</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a href="/logout" class="dropdown-item"><i class="fa-solid fa-right-from-bracket ms-1"></i> تسجيل الخروج</a></li>
          </ul>
        </li>
        <% } else { %>
        <li class="nav-item"><a href="/login" class="nav-link px-2"><i class="fa-solid fa-right-to-bracket ms-1"></i> تسجيل الدخول</a></li>
        <li class="nav-item"><a href="/register" class="nav-link px-2"><i class="fa-solid fa-user-plus ms-1"></i> إنشاء حساب</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
