<%~ includeFile("partials/header.eta", { user: user }) %>
<%~ includeFile("partials/message.eta") %>

<% const botOnline = typeof global.botID === "string" && global.botID.length > 0; %>
<% const totalThreads = global.db.allThreadData.length; %>
<% const totalUsers = global.db.allUserData.length; %>
<% const totalCommands = global.GoatBot.commands.size; %>

<main class="m3-shell" dir="rtl">
  <aside class="m3-rail">
    <div class="m3-rail-brand"><span class="m3-logo">R</span><strong>Ragnar</strong></div>
    <a class="active" href="/dashboard"><i class="fas fa-gauge-high"></i><span>الداشبورد</span></a>
    <a href="/stats"><i class="fas fa-chart-simple"></i><span>الإحصائيات</span></a>
  </aside>
  <section class="m3-content">
    <section class="m3-hero">
      <div>
        <span class="m3-label">RagnarBot-V0</span>
        <h1>مركز تحكم Saga Sama</h1>
        <p>واجهة تشغيل عربية Material 3 لإدارة البوت، المجموعات، الأوامر، الحماية، وحالة النظام بدون تسجيل وبدون الواجهة القديمة.</p>
        <div class="m3-actions">
          <a class="m3-btn filled" href="/dashboard">فتح لوحة التحكم</a>
          <a class="m3-btn tonal" href="/stats">الإحصائيات</a>
        </div>
      </div>
      <article class="m3-status-card">
        <span class="m3-pulse"></span>
        <h2><% if (botOnline) { %>البوت متصل<% } else { %>بانتظار الاتصال<% } %></h2>
        <p><%= totalCommands %> أمر · <%= totalThreads %> مجموعة · <%= totalUsers %> مستخدم</p>
      </article>
    </section>
  </section>
</main>

<%~ includeFile('partials/footer.eta') %>
