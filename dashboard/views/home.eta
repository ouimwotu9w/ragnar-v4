<%~ includeFile("partials/header.eta", {
	user: user
}) %>
<%~ includeFile("partials/message.eta") %>

<% const botOnline = typeof global.botID === "string" && global.botID.length > 0; %>
<% const totalThreads = global.db.allThreadData.length; %>
<% const totalUsers = global.db.allUserData.length; %>
<% const totalCommands = global.GoatBot.commands.size; %>
<% const botPrefix = global.GoatBot.config.prefix; %>

<!-- ============================================================
     ✨ Hero
     ============================================================ -->
<section class="landing-hero">
	<div class="container">
		<div class="text-center">
			<span class="hero-eyebrow">
				<span class="dot"></span>
				<% if (botOnline) { %>Bot is online &amp; ready<% } else { %>Setup required to go live<% } %>
			</span>

			<h1 class="landing-title">
				Power your chats with<br>
				<span class="grad">GoatBot-Pro</span>
			</h1>

			<p class="landing-sub">
				An open-source Facebook Messenger bot framework — moderation, custom commands,
				rank &amp; levels, multi-language and a full web dashboard. Fast, smart and
				built to be yours.
			</p>

			<div class="landing-cta">
				<% if (botOnline) { %>
				<a class="btn-hero btn-hero-primary" href="https://www.facebook.com/<%= global.botID %>" target="_blank" rel="noopener">
					<i class="fab fa-facebook-messenger"></i> Add bot to your chat
				</a>
				<% } %>
				<a class="btn-hero btn-hero-ghost" href="/dashboard">
					<i class="fas fa-cog"></i> Open dashboard
				</a>
				<a class="btn-hero btn-hero-ghost" href="/stats">
					<i class="fas fa-chart-bar"></i> View stats
				</a>
			</div>
		</div>
	</div>
</section>

<!-- ============================================================
     ✨ Stats strip
     ============================================================ -->
<section class="landing-stats">
	<div class="container">
		<div class="row g-4">
			<div class="col-6 col-lg-3 reveal">
				<div class="stat-card">
					<div class="stat-value grad"><%= totalThreads %></div>
					<div class="stat-label">Active chats</div>
				</div>
			</div>
			<div class="col-6 col-lg-3 reveal">
				<div class="stat-card">
					<div class="stat-value grad"><%= totalUsers %></div>
					<div class="stat-label">Users served</div>
				</div>
			</div>
			<div class="col-6 col-lg-3 reveal">
				<div class="stat-card">
					<div class="stat-value grad"><%= totalCommands %></div>
					<div class="stat-label">Commands</div>
				</div>
			</div>
			<div class="col-6 col-lg-3 reveal">
				<div class="stat-card">
					<div class="stat-value grad"><%= botPrefix %></div>
					<div class="stat-label">Command prefix</div>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- ============================================================
     ✨ Features
     ============================================================ -->
<section class="landing-section">
	<div class="container">
		<div class="text-center mb-5 reveal">
			<h2 class="landing-section-heading">Everything your group needs</h2>
			<p class="landing-section-sub">
				From moderation to fun, GoatBot-Pro ships with a rich set of built-in features
				you can control right from the dashboard.
			</p>
		</div>

		<div class="row g-4">
			<div class="col-md-6 col-lg-4 reveal">
				<div class="feature-card">
					<span class="feature-icon"><i class="fas fa-user-shield"></i></span>
					<h3 class="feature-title">Moderation</h3>
					<p class="feature-desc">Ban, warn, filter bad words, anti-leave and admin-only
					controls to keep every chat safe and friendly.</p>
				</div>
			</div>
			<div class="col-md-6 col-lg-4 reveal">
				<div class="feature-card">
					<span class="feature-icon"><i class="fas fa-terminal"></i></span>
					<h3 class="feature-title">Custom commands</h3>
					<p class="feature-desc">Create your own commands with a simple, documented API —
					reply, reaction and event handlers included.</p>
				</div>
			</div>
			<div class="col-md-6 col-lg-4 reveal">
				<div class="feature-card">
					<span class="feature-icon"><i class="fas fa-trophy"></i></span>
					<h3 class="feature-title">Rank &amp; levels</h3>
					<p class="feature-desc">Reward your most active members with experience,
					levels and custom rank cards that celebrate progress.</p>
				</div>
			</div>
			<div class="col-md-6 col-lg-4 reveal">
				<div class="feature-card">
					<span class="feature-icon"><i class="fas fa-language"></i></span>
					<h3 class="feature-title">Multi-language</h3>
					<p class="feature-desc">Speaks English, Arabic, Bengali, Hindi, Tagalog and
					Vietnamese out of the box — switch per chat.</p>
				</div>
			</div>
			<div class="col-md-6 col-lg-4 reveal">
				<div class="feature-card">
					<span class="feature-icon"><i class="fas fa-images"></i></span>
					<h3 class="feature-title">Welcome cards</h3>
					<p class="feature-desc">Greet new members with beautiful, personalised welcome
					cards and say goodbye when someone leaves.</p>
				</div>
			</div>
			<div class="col-md-6 col-lg-4 reveal">
				<div class="feature-card">
					<span class="feature-icon"><i class="fas fa-gauge-high"></i></span>
					<h3 class="feature-title">Web dashboard</h3>
					<p class="feature-desc">Manage threads, welcome messages, custom commands and
					more from an intuitive, real-time web panel.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- ============================================================
     ✨ Get started
     ============================================================ -->
<section class="landing-section" style="background: var(--landing-bg-2);">
	<div class="container">
		<div class="text-center mb-5 reveal">
			<h2 class="landing-section-heading">Get started in minutes</h2>
			<p class="landing-section-sub">Three simple steps and your bot is live.</p>
		</div>

		<div class="row g-4 justify-content-center">
			<div class="col-md-4 reveal">
				<div class="step-wrap text-center">
					<span class="step-num">1</span>
					<div class="step-title">Add your cookies</div>
					<p class="step-desc">Paste your Facebook cookies into <code>account.txt</code>
					and tweak <code>config.json</code>.</p>
				</div>
			</div>
			<div class="col-md-4 reveal">
				<div class="step-wrap text-center">
					<span class="step-num">2</span>
					<div class="step-title">Run the bot</div>
					<p class="step-desc"><code>npm install</code> then <code>node index.js</code>
					— the bot logs in and starts listening.</p>
				</div>
			</div>
			<div class="col-md-4 reveal">
				<div class="step-wrap text-center">
					<span class="step-num">3</span>
					<div class="step-title">Open the dashboard</div>
					<p class="step-desc">Visit the dashboard to register, configure your threads and
					manage everything in one place.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<script type="text/javascript">
	(function () {
		// Reveal-on-scroll
		var els = document.querySelectorAll('.reveal');
		if ('IntersectionObserver' in window) {
			var io = new IntersectionObserver(function (entries) {
				entries.forEach(function (entry) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						io.unobserve(entry.target);
					}
				});
			}, { threshold: 0.12 });
			els.forEach(function (el) { io.observe(el); });
		} else {
			els.forEach(function (el) { el.classList.add('is-visible'); });
		}
	})();
</script>

<%~ includeFile('partials/footer.eta') %>
