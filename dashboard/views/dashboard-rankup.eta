<%~ includeFile("partials/header.eta", { user: user }); %>
<%~ includeFile("partials/message.eta"); %>

<section class="ragnar-page-head">
  <div>
    <a href="/dashboard/<%= threadID %>" class="ragnar-kicker text-decoration-none"><i class="fa-solid fa-arrow-right ms-1"></i> الرجوع لإعدادات المجموعة</a>
    <h1 class="ragnar-page-title">إشعار الترقية</h1>
    <p class="ragnar-page-description mb-0">تفعيل الإشعار متاح من صفحة المجموعة؛ تخصيص النص التفصيلي غير مدعوم بعد في النسخة الحالية من البوت.</p>
  </div>
  <span class="ragnar-badge warning"><i class="fa-solid fa-clock"></i> قيد الإتاحة</span>
</section>

<section class="ragnar-card p-4">
  <div class="d-flex align-items-start gap-3">
    <span class="ragnar-stat-icon warning"><i class="fa-solid fa-trophy"></i></span>
    <div>
      <h2 class="ragnar-section-title mb-2">ماذا يعمل الآن؟</h2>
      <p class="ragnar-page-description mb-3">عند تشغيل مفتاح «إشعار الترقية» من إعدادات المجموعة، يرسل البوت رسالة الترقية الافتراضية عند زيادة مستوى العضو. أبقينا هذه الصفحة واضحة بدل تقديم حقل لن يحفظه البوت.</p>
      <a href="/dashboard/<%= threadID %>" class="btn btn-ragnar-primary"><i class="fa-solid fa-sliders ms-1"></i> الرجوع للتشغيل التلقائي</a>
    </div>
  </div>
</section>

<%~ includeFile("partials/footer.eta") %>
